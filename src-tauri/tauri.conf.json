{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kwiken",
  "version": "2.2.3",
  "identifier": "com.kwiken.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kwiken",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Personal finance manager for Windows",
    "longDescription": "Kwiken is a Quicken-style desktop personal finance manager. Track accounts, transactions, budgets, and reports with local SQLite storage.",
    "copyright": "Copyright © 2026 Kwiken",
    "publisher": "Kwiken",
    "homepage": "https://github.com/rattaroaz/kwiken",
    "category": "Finance",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Kwiken",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "lzma"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMzFGMEM0QTJBMkI0MEIKUldRTHRLS2l4UEF4am1kV3JNdzlyTkpSUStvZEN1M1dSdjVDbGhMTFNjajRXajZKWkp4THROdXYK",
      "endpoints": [
        "https://github.com/rattaroaz/kwiken/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
